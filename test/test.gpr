with "../one.gpr";

project Test is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/test";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../bin";
   for Main use ("test_runner.adb");

   package Naming is
      for Spec ("Test_Math") use "test_one.ads";
      for Body ("Test_Math") use "test_one.adb";
   end Naming;
end Test;
